<Window x:Class="vRemoter.Windows.Input.OverlayAppSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen">
    <Border Background="#EB15171A"
            BorderBrush="#40FFFFFF"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16,14">
        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       Text="切换应用"
                       Foreground="#8C919B"
                       FontSize="11.5"
                       FontWeight="SemiBold"
                       Margin="4,0,4,10" />
            <WrapPanel x:Name="ItemsHost" MaxWidth="760" />
        </StackPanel>
    </Border>
</Window>

