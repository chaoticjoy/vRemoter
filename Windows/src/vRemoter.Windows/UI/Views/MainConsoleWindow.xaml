<Window x:Class="vRemoter.Windows.UI.Views.MainConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vRemoter 控制台"
        Width="790"
        Height="685"
        MinWidth="775"
        MinHeight="658"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPanel}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource ConsoleCardStyle}" Padding="18,0" CornerRadius="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="288" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="pack://application:,,,/Assets/vRemoterLogo.png"
                       Width="42"
                       Height="42"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="vRemoter"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}" />
                    <TextBlock x:Name="VersionLabel"
                               Text="1.4.0 · 社区版"
                               FontSize="11"
                               Foreground="{StaticResource BrushSecondary}" />
                </StackPanel>

                <Border Grid.Column="4"
                        Background="#B8060708"
                        CornerRadius="11"
                        Padding="3"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="TabMixerBtn" Grid.Column="0" Style="{StaticResource ConsoleBareButtonStyle}" Click="OnTabMixerClick" Height="30" Cursor="Hand" />
                        <Button x:Name="TabMappingBtn" Grid.Column="1" Style="{StaticResource ConsoleBareButtonStyle}" Click="OnTabMappingClick" Height="30" Cursor="Hand" />
                        <Button x:Name="TabFocusBtn" Grid.Column="2" Style="{StaticResource ConsoleBareButtonStyle}" Click="OnTabFocusClick" Height="30" Cursor="Hand" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource BrushAmber}" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusHeaderLabel"
                               Text="正在连接"
                               FontSize="13.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAmber}"
                               VerticalAlignment="Center" />
                    <Button x:Name="StopMicButton"
                            Content="结束录音"
                            Style="{StaticResource ConsoleButtonDanger}"
                            Margin="10,0,0,0"
                            Visibility="Collapsed"
                            Click="OnStopMicClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="2" />
    </Grid>
</Window>

