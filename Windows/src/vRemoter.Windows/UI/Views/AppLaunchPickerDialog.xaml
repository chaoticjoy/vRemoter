<Window x:Class="vRemoter.Windows.UI.Views.AppLaunchPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打开指定应用"
        Width="480"
        Height="418"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="TitleText" Text="打开指定应用" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" />
            <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource BrushSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource BrushSurface2}" CornerRadius="12" Padding="12" Margin="0,14,0,10">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedAppName" Text="尚未选择应用" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource BrushSecondary}" />
                    <TextBlock x:Name="SelectedAppId" Text="支持任意 .exe 或快捷方式" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource BrushTertiary}" Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="BrowseBtn" Content="浏览 .exe…" Style="{StaticResource ConsoleButtonNeutral}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnBrowseClick" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="RunningHint" Text="或从当前运行中的应用快速选择：" FontSize="11" Foreground="{StaticResource BrushSecondary}" Margin="0,0,0,6" />
            <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="RunningAppsWrap" />
            </ScrollViewer>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10,0,14">
            <CheckBox x:Name="AutoFocusCheck" Content="打开后自动将输入焦点切入输入框" Foreground="{StaticResource BrushText}" FontSize="12" IsChecked="True" Margin="0,0,0,6" />
            <CheckBox x:Name="AddAutoFocusCheck" Content="同时加入「切换应用自动聚焦」名单" Foreground="{StaticResource BrushText}" FontSize="12" IsChecked="True" />
        </StackPanel>

        <Grid Grid.Row="4">
            <Button x:Name="CancelBtn" Content="取消" Style="{StaticResource ConsoleButtonNeutral}" HorizontalAlignment="Left" Click="OnCancelClick" />
            <Button x:Name="SaveBtn" Content="保存映射" Style="{StaticResource ConsoleButtonGood}" HorizontalAlignment="Right" IsEnabled="False" Click="OnSaveClick" />
        </Grid>
    </Grid>
</Window>

