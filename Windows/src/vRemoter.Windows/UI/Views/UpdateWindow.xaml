<Window x:Class="vRemoter.Windows.UI.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本与更新"
        Width="500"
        Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushPanel}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="pack://application:,,,/Assets/vRemoterLogo.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="vRemoter" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock x:Name="VersionText" Text="版本 1.4.0" FontSize="13.5" Foreground="{StaticResource BrushSecondary}" HorizontalAlignment="Center" Margin="0,4,0,14" />

            <Border x:Name="ReleaseNotesBox" Visibility="Collapsed" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLine}" BorderThickness="1" CornerRadius="8" Width="430" Height="130" Padding="10" Margin="0,0,0,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ReleaseNotesText" FontSize="12" Foreground="{StaticResource BrushText}" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="StatusText" FontSize="12.5" Foreground="{StaticResource BrushGreen}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                <Button x:Name="CheckBtn" Content="检查更新" Style="{StaticResource ConsoleButtonGood}" Width="165" Height="38" Click="OnCheckOrInstallClick" />
            </StackPanel>
            <CheckBox x:Name="AutoUpdateCheck" Content="自动检查更新" Foreground="{StaticResource BrushText}" FontSize="12.5" HorizontalAlignment="Center" Click="OnAutoUpdateClick" />
        </StackPanel>
    </Grid>
</Window>

