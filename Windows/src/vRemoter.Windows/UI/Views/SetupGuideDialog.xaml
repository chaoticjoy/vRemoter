<Window x:Class="vRemoter.Windows.UI.Views.SetupGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="环境配置引导"
        Width="520"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushPanel}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="GuideTitle" Text="配置引导" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" />

        <Border Grid.Row="1" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushLineSoft}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="GuideBody" FontSize="12.5" Foreground="{StaticResource BrushText}" TextWrapping="Wrap" LineHeight="21" />
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="11.5" Foreground="{StaticResource BrushGreen}" Margin="0,0,0,10" TextWrapping="Wrap" />

        <Grid Grid.Row="3">
            <Button x:Name="SecondaryBtn" Content="打开官网" Style="{StaticResource ConsoleButtonNeutral}" HorizontalAlignment="Left" Click="OnSecondaryClick" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CloseBtn" Content="关闭" Style="{StaticResource ConsoleButtonNeutral}" Margin="0,0,8,0" Click="OnCloseClick" />
                <Button x:Name="PrimaryBtn" Content="立即操作" Style="{StaticResource ConsoleButtonGood}" Click="OnPrimaryClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

